# ==============================================================================
# SUPABASE BACKEND CONFIGURATION
# ==============================================================================
# Dapatkan kredensial ini dari Supabase Dashboard:
# 1. Buka https://supabase.com/dashboard
# 2. Masuk ke Project Anda -> Settings -> API
# 3. Salin Project URL dan anon public API Key
# 4. Salin file ini menjadi `.env` di root direktori proyek

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Catatan:
# Jika environment variables di atas belum diisi atau masih menggunakan placeholder,
# aplikasi secara otomatis beralih ke Mode Demo (fallback data statis lokal).
